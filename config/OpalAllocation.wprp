<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="Opal">
  <Profiles>
    <SystemCollector Id="OpalSystem" Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="64"/>
    </SystemCollector>
    <SystemProvider Id="OpalAllocationProvider">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="VirtualAllocation"/>
      </Keywords>
      <Stacks><Stack Value="VirtualAllocation"/></Stacks>
    </SystemProvider>
    <Profile Id="OpalAllocation.Verbose.Memory" Name="OpalAllocation" Description="Bounded allocation stack capture" DetailLevel="Verbose" LoggingMode="Memory">
      <Collectors><SystemCollectorId Value="OpalSystem"><SystemProviderId Value="OpalAllocationProvider"/></SystemCollectorId></Collectors>
    </Profile>
    <Profile Id="OpalAllocation.Verbose.File" Name="OpalAllocation" Description="Allocation stack capture" DetailLevel="Verbose" LoggingMode="File">
      <Collectors><SystemCollectorId Value="OpalSystem"><SystemProviderId Value="OpalAllocationProvider"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
